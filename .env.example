# ============================================================================
# BayernRP All-in-One Bot – Umgebungsvariablen
# Kopiere diese Datei zu ".env" für lokale Entwicklung.
# Auf Railway werden dieselben Variablen im "Variables"-Tab gesetzt.
# ============================================================================

# --- Discord (Pflicht) -------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# --- Datenbank (Pflicht) -----------------------------------------------------
# Railway PostgreSQL Plugin stellt diese Variable automatisch bereit.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Rollen (optional, kommagetrennt bei mehreren IDs) -----------------------
ROLE_ADMIN=
ROLE_HIGH_TEAM=
ROLE_TEAM=

# --- Kanäle (optional) --------------------------------------------------------
CHANNEL_LOGS=
CHANNEL_ERRORS=

# --- Embed-Design (optional, Hex-Farben ohne #) -------------------------------
EMBED_COLOR_PRIMARY=2b6cff
EMBED_COLOR_SUCCESS=57f287
EMBED_COLOR_ERROR=ed4245
EMBED_COLOR_WARNING=fee75c
EMBED_FOOTER_TEXT=BayernRP • All-in-One Management
EMBED_FOOTER_ICON_URL=

# --- Sonstiges ------------------------------------------------------------
NODE_ENV=production

# --- Web-Service / Health-Check -----------------------------------------
# Render (Web Service) setzt PORT automatisch selbst - hier nur relevant
# für lokale Tests. Health-Check erreichbar unter GET / und GET /health.
PORT=3000
